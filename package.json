{
  "name": "readme-path-guard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catch newly broken repository-relative README links in pull requests.",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test",
    "build": "esbuild src/action.mjs --bundle --platform=node --format=cjs --target=node24 --outfile=dist/action.cjs && esbuild src/app-worker.mjs --bundle --platform=node --format=cjs --target=node24 --outfile=dist/app-worker.cjs"
  },
  "dependencies": { "commonmark": "0.31.2" },
  "devDependencies": { "esbuild": "0.28.2" }
}
